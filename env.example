# Copy this file to .env for local testing.
# On Railway, add these in the Variables tab instead.

AGENTMAIL_API_KEY=your_real_agentmail_api_key_here
AGENTMAIL_INBOX=siteflow.dont.reply@agentmail.to

# Make this a long random secret.
# Example generation command:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERIFICATION_SECRET=replace_with_a_long_random_secret

# Railway supplies PORT automatically.
# PORT=3000
